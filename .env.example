# ---------- Core ----------
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# ---------- Database ----------
DATABASE_URL=postgresql://mexa:mexa@localhost:5432/mexa

# ---------- Redis (optional: realtime fan-out across API replicas) ----------
REDIS_URL=redis://localhost:6379

# ---------- Object storage (S3-compatible; MinIO in dev) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mexa
S3_ACCESS_KEY_ID=mexa
S3_SECRET_ACCESS_KEY=mexa-secret

# ---------- Auth (Better Auth) ----------
AUTH_SECRET=change-me-32-bytes-minimum
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---------- Secrets vault (AES-256-GCM master key, base64) ----------
VAULT_MASTER_KEY=

# ---------- Model providers (bring your own; Grok is the default) ----------
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Computer (sandbox) provider ----------
# local-docker | docker-remote | e2b | daytona | fly
COMPUTER_PROVIDER=local-docker
COMPUTER_IMAGE=ghcr.io/mexa/computer:edge
DOCKER_HOST=
E2B_API_KEY=
DAYTONA_API_KEY=

# ---------- Notifications ----------
EXPO_ACCESS_TOKEN=
SMTP_URL=smtp://localhost:1025

# ---------- Billing ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_SECRET=

# ---------- Observability ----------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
POSTHOG_KEY=
